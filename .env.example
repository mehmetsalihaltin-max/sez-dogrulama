# Copy to .env. Every key is optional: without keys the demo opens the saved example runs.

# Meta Model API (Muse Spark, Muse Image, Muse Voice Transcribe). Needed for new questions, voice questions and satellite commentary.
MODEL_API_KEY=
# Optional model overrides.
# MUSE_MODEL=
# TARAMA_MODELI=

# Google Maps JavaScript API key for the 3D map. Restrict it to your host. Without it a 2D map is drawn.
GOOGLE_HARITA_ANAHTARI=

# Autorouter account for live NOTAMs. Without it the NOTAM box says it is not connected.
AUTOROUTER_KULLANICI=
AUTOROUTER_SIFRE=

# Flightradar24 API key for real flight tracks. Without it a recorded track or the great-circle line is used.
FR24_API_ANAHTARI=

# PORT=4173
